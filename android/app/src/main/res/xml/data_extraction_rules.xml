<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="app_flutter/class_box.hive" />
        <include domain="root" path="app_flutter/snapshot_box.hive" />
        <include domain="root" path="app_flutter/settings_box.hive" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/class_box.hive" />
        <include domain="root" path="app_flutter/snapshot_box.hive" />
        <include domain="root" path="app_flutter/settings_box.hive" />
    </device-transfer>
</data-extraction-rules>
